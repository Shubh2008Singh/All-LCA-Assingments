    "# to check whether or not the triangle using function\n",
    "def check_right_triangle():\n",
    "    L = []\n",
    "    for i in range(3):\n",
    "        side = int(input(\"enter side lenghts:\"))\n",
    "        L.append(side)\n",
    "    c = max(L)\n",
    "    L.remove(c)\n",
    "    a = L[0]\n",
    "    b = L[1]\n",
    "    sum = a**2 + b**2\n",
    "    if sum == (c**2):\n",
    "        print(\"right angled triangle\")\n",
    "    elif sum != (c**2):\n",
    "        print(\" not right angled triangle\")\n",
    "check_right_triangle()"
